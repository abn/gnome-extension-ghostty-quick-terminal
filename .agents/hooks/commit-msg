#!/usr/bin/env bash
# Rejects commit messages that break the repository conventions:
# Conventional Commits prefix, summary length, no trailers, no emoji.
set -euo pipefail

msg_file=$1
types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'

# Drop comment lines and trailing blank lines.
mapfile -t lines < <(grep -v '^#' "$msg_file" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')
summary=${lines[0]:-}

fail() { printf 'commit-msg: %s\n' "$1" >&2; exit 1; }

[[ -n "$summary" ]] || fail 'empty message'
[[ "$summary" =~ ^(fixup|squash)!\  ]] && exit 0

[[ "$summary" =~ ^($types)(\([a-z0-9._/-]+\))?!?:\ [^[:space:]] ]] \
  || fail "summary must look like 'type(scope): description' with type in: ${types//|/, }"
(( ${#summary} <= 72 )) || fail 'summary longer than 72 characters'
(( ${#summary} <= 50 )) || printf 'commit-msg: summary over 50 characters, consider shortening\n' >&2

for line in "${lines[@]:1}"; do
  (( ${#line} <= 72 )) || fail "body line longer than 72 characters: ${line:0:40}..."
done

# Trailers (Signed-off-by, Co-authored-by, and similar) are not used here.
for line in "${lines[@]:1}"; do
  [[ "$line" =~ ^[A-Za-z][A-Za-z-]+:\ .+ ]] && fail "trailer not allowed: ${line%%:*}"
done

if grep -qP '[\x{1F000}-\x{1FAFF}\x{2600}-\x{27BF}\x{2B00}-\x{2BFF}]' "$msg_file"; then
  fail 'emoji not allowed'
fi
if grep -q $'—' "$msg_file"; then
  fail 'em-dash not allowed'
fi
exit 0
